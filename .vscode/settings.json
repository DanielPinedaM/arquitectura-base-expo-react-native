{
  // ocultar en el explorador de VS Code (Ctrl + Shift + E) las carpetas de configuracion para IA diferentes a .agents
  "files.exclude": {
    ".github": true,
    ".claude": true,
    ".cursor": true,
    ".deepcode": true,
    ".grok": true,
    ".gemini": true,
    ".opencode": true,
    ".pi": true,
    ".codex": true,
    ".openclaw": true
  },

  // ocultar en la busqueda de VS Code (Ctrl + Shift + F) las carpetas de configuracion para IA diferentes a .agents
  "search.exclude": {
    ".github": true,
    ".claude": true,
    ".cursor": true,
    ".deepcode": true,
    ".grok": true,
    ".gemini": true,
    ".opencode": true,
    ".pi": true,
    ".codex": true,
    ".openclaw": true
  },

  "editor.codeActionsOnSave": {
    "source.fixAll": "explicit",
    "source.organizeImports": "explicit",
    "source.sortMembers": "explicit"
  }
}
