{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "paths": {
      /* -------------  carpeta contenedora de codigo fuente ------------- */
      "@/*": ["./src/*"],

      /* ------------- carpeta para multimedia ------------- */
      "@/assets/*": ["./assets/*"],

      /* -------------  carpeta de variables de entorno ------------- */
      "@/environments/*": ["./environments/*"]
    }
  },
  "include": ["**/*.ts", "**/*.tsx", ".expo/types/**/*.ts", "expo-env.d.ts"]
}
